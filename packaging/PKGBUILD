# Maintainer: Armin Schneider <JXS1985@users.noreply.github.com>
pkgname=clamav-security-center
pkgver=1.0.0
pkgrel=1
pkgdesc="ClamAV Security Center GUI for KDE Plasma and GNOME"
arch=('any')
url="https://github.com/JXS1985/ClamAV-GUI"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'pyside6'
  'clamav'
  'findutils'
  'procps-ng'
  'polkit'
  'libnotify'
)
optdepends=(
  'xdg-desktop-portal-kde: KDE Plasma portal & notifications integration'
  'xdg-desktop-portal-gtk: GNOME portal & file dialog integration'
  'breeze-icons: KDE Breeze icon theme'
)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/JXS1985/ClamAV-GUI/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  local srcdir_root="${srcdir}/ClamAV-GUI-${pkgver}"
  if [[ ! -d "${srcdir_root}" ]]; then
    srcdir_root="${srcdir}"
  fi

  install -d "${pkgdir}/usr/share/${pkgname}"
  install -d "${pkgdir}/usr/bin"
  install -d "${pkgdir}/usr/share/applications"
  install -d "${pkgdir}/usr/share/icons/hicolor/scalable/apps"

  install -m 0755 "${srcdir_root}/clamav_gui.py" "${pkgdir}/usr/share/${pkgname}/clamav_gui.py"
  install -m 0755 "${srcdir_root}/run.sh" "${pkgdir}/usr/share/${pkgname}/run.sh"

  cat > "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
exec /usr/share/clamav-security-center/run.sh "$@"
EOF
  chmod 0755 "${pkgdir}/usr/bin/${pkgname}"
  ln -s "${pkgname}" "${pkgdir}/usr/bin/clamav-kde-gui"

  cat > "${pkgdir}/usr/share/applications/clamav-kde-gui.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Version=1.0
Name=ClamAV Security Center
Name[de]=ClamAV Sicherheitszentrum
GenericName=Antivirus Scanner GUI
GenericName[de]=Virenscanner-Oberfläche
Comment=Monitor and control ClamAV scans, quarantine, and virus signatures
Comment[de]=ClamAV-Scans, Quarantäne und Virensignaturen überwachen und steuern
Exec=/usr/bin/clamav-security-center
Icon=clamav-kde-gui
Terminal=false
Categories=System;Security;Qt;GTK;KDE;GNOME;
StartupWMClass=clamav-kde-gui
EOF
  chmod 0644 "${pkgdir}/usr/share/applications/clamav-kde-gui.desktop"
  install -m 0644 "${srcdir_root}/packaging/clamav-kde-gui.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/clamav-kde-gui.svg"
}
